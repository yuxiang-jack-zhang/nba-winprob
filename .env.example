# Copy to .env and adjust. Every path defaults to a location inside the repo,
# so the project runs with no .env at all.

# Where data lives. Subdirectories: baseline/ raw/ interim/ processed/
NBA_DATA_DIR=./data

# Where trained models and their metrics.json are written.
NBA_ARTIFACT_DIR=./artifacts

# The Kaggle NBA archive (1.6 GB). Only needed to rebuild the in-game
# possession data; the pregame models train off data/baseline/.
NBA_ARCHIVE_PATH=./data/datasets.zip

# Postgres. Matches docker-compose.yml (`make db-up`).
NBA_DATABASE_URL=postgresql://nba:nba@localhost:5433/nba

# Global seed for splits, torch and the possession simulator.
NBA_SEED=0

# Held-out test season. Never shuffle across seasons.
NBA_TEST_SEASON=2023

# Earliest season with usable play-by-play for the in-game model.
NBA_INGAME_MIN_SEASON=2017
